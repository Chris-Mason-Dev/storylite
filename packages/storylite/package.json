{
  "name": "@storylite/storylite",
  "version": "1.1.1",
  "description": "Lightweight alternative to Storybook for HTML, React, Preact, Svelte, Vue, and Solid component stories",
  "keywords": [
    "component-development",
    "component-stories",
    "html",
    "preact",
    "react",
    "solid",
    "storybook",
    "storylite",
    "svelte",
    "vite",
    "vue",
    "web-components"
  ],
  "homepage": "https://itsjavi.com/storylite",
  "bugs": {
    "url": "https://github.com/itsjavi/storylite/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/itsjavi/storylite.git",
    "directory": "packages/storylite"
  },
  "bin": {
    "storylite": "./bin/storylite.mjs"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/public.ts",
      "default": "./src/public.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "node ./bin/storylite.mjs dev",
    "build": "node ./bin/storylite.mjs build",
    "preview": "node ./bin/storylite.mjs preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "typecheck": "pnpm check",
    "publint": "publint",
    "prepublishOnly": "pnpm typecheck && pnpm build && pnpm publint",
    "test": "vitest run",
    "version": "node ../../scripts/sync-public-package-versions.mjs --stage"
  },
  "dependencies": {
    "@lucide/svelte": "^1.16.0",
    "@storylite/contracts": "workspace:*",
    "@storylite/preview-host": "workspace:*",
    "mdsvex": "^0.12.7"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^25.9.1",
    "fast-glob": "^3.3.3",
    "svelte": "^5.55.9",
    "svelte-check": "^4.4.8",
    "typescript": "^6.0.3",
    "vite": "^8.0.14"
  }
}
